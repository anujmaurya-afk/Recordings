{
  "buildCommand": "cd recording_converter/frontend && npm install && npm run build",
  "outputDirectory": "recording_converter/frontend/dist",
  "functions": {
    "recording_converter/api/index.py": {
      "runtime": "python3.12"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/recording_converter/api/index.py" },
    { "source": "/health", "destination": "/recording_converter/api/index.py" }
  ]
}