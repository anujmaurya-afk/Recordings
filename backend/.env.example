# ─── AWS ────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ─── S3 Presigned URL (recordings.py) ───────────────────────────────────────
# Expiry in seconds — 604800 = 7 days
RECORDING_URL_EXPIRY_SECONDS=604800

# ─── CloudFront (cloudfront.py) ─────────────────────────────────────────────
CLOUDFRONT_DOMAIN=https://d30beya68etkmf.cloudfront.net
# CloudFront URL expiry in days (only used when signing credentials are provided)
CLOUDFRONT_URL_EXPIRY_DAYS=30
# Optional: for signed CloudFront URLs (leave empty for unsigned CDN URLs)
CLOUDFRONT_KEY_PAIR_ID=
# PEM private key as a single line with \n escaping, e.g. -----BEGIN RSA PRIVATE KEY-----\nMIIE...
CLOUDFRONT_PRIVATE_KEY=

# ─── URL Provider ────────────────────────────────────────────────────────────
# "recordings"  → 7-day S3 presigned URL  (default)
# "cloudfront"  → CloudFront URL (30-day signed if keys provided, otherwise permanent)
URL_PROVIDER=recordings

# ─── Worker Pool ─────────────────────────────────────────────────────────────
MAX_WORKERS=5

# ─── File Uploads ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite database path (relative to backend directory)
DATABASE_PATH=./data/jobs.db

# ─── Server ───────────────────────────────────────────────────────────────────
# Frontend origin for CORS (comma-separated for multiple)
CORS_ORIGINS=http://localhost:5173
